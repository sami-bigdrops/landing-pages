{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "LEADPROSPER_CAMPAIGN_ID",
    "LEADPROSPER_SUPPLIER_ID",
    "LEADPROSPER_API_KEY",
    "LEADPROSPER_API_URL",
    "LEADPROSPER_PING_URL",
    "VERIPHONE_API_KEY",
    "AWS_REGION",
    "AWS_ACCESS_KEY_ID",
    "AWS_SECRET_ACCESS_KEY",
    "AWS_SES_FROM_EMAIL",
    "SES_REPLY_TO",
    "SITE_URL",
    "NEXT_PUBLIC_SITE_URL",
    "SES_EMAIL_UNSUBSCRIBE_URL",
    "SES_EMAIL_FOOTER_ADDRESS",
    "TEST_EMAIL",
    "HUNTER_API_KEY",
    "HUNTER_API_KEY_2",
    "SET_HUNTER",
    "SET_VERIPHONE",
    "AROHAA_LANDING_PAGE_ID",
    "NEXT_PUBLIC_AROHAA_WID",
    "AROHAA_INGEST_API_BASE",
    "NEXT_PUBLIC_AROHAA_INGEST_API_BASE",
    "AROHAA_UTM_DENIED_PATH",
    "NEXT_PUBLIC_VAPID_PUBLIC_KEY",
    "VAPID_PRIVATE_KEY",
    "VAPID_SUBJECT",
    "WEB_PUSH_MODEL",
    "WEB_PUSH_SUBSCRIBE_URL",
    "WEB_PUSH_UNSUBSCRIBE_URL",
    "WEB_PUSH_EVENTS_URL",
    "WEB_PUSH_WEBHOOK_SECRET",
    "WEB_PUSH_SEND_SECRET"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"],
      "env": [
        "NODE_ENV",
        "DATABASE_URL",
        "LEADPROSPER_CAMPAIGN_ID",
        "LEADPROSPER_SUPPLIER_ID",
        "LEADPROSPER_API_KEY",
        "LEADPROSPER_API_URL",
    "LEADPROSPER_PING_URL",
        "REFI_LEADPROSPER_CAMPAIGN_ID",
        "REFI_LEADPROSPER_SUPPLIER_ID",
        "REFI_LEADPROSPER_API_KEY",
        "REFI_LEADPROSPER_API_URL",
        "HP_LEADPROSPER_CAMPAIGN_ID",
        "HP_LEADPROSPER_SUPPLIER_ID",
        "HP_LEADPROSPER_API_KEY",
        "HP_LEADPROSPER_API_URL",
        "VERIPHONE_API_KEY",
        "AWS_REGION",
        "AWS_ACCESS_KEY_ID",
        "AWS_SECRET_ACCESS_KEY",
        "AWS_SES_FROM_EMAIL",
        "SES_REPLY_TO",
        "SITE_URL",
        "NEXT_PUBLIC_SITE_URL",
        "SES_EMAIL_UNSUBSCRIBE_URL",
        "SES_EMAIL_FOOTER_ADDRESS",
        "TEST_EMAIL",
        "DASHBOARD_BRAND_ID",
        "HUNTER_API_KEY",
        "HUNTER_API_KEY_2",
        "SET_HUNTER",
        "SET_VERIPHONE",
        "NEXT_PUBLIC_VAPID_PUBLIC_KEY",
        "NEXT_PUBLIC_AROHAA_WID",
        "VAPID_PRIVATE_KEY",
        "VAPID_SUBJECT",
        "WEB_PUSH_MODEL",
        "WEB_PUSH_SUBSCRIBE_URL",
        "WEB_PUSH_UNSUBSCRIBE_URL",
        "WEB_PUSH_EVENTS_URL",
        "WEB_PUSH_WEBHOOK_SECRET",
        "WEB_PUSH_SEND_SECRET"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
