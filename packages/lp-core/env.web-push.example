# Web Push — Model B (Arohaa Notification Center)
# Paste values from Arohaa → Notification Center → LP wiring.
#
# LPs handle: permission UX, subscribe/unsubscribe webhooks, SW, lifecycle events.
# Arohaa owns: subscription storage, VAPID private key, campaigns, delivery.

# Arohaa public VAPID key (safe for browser)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Landing page public UUID from Arohaa
NEXT_PUBLIC_AROHAA_WID=

# Arohaa webhooks
WEB_PUSH_SUBSCRIBE_URL=https://api.arohaa.net/v1/web-push/subscriptions
WEB_PUSH_UNSUBSCRIBE_URL=https://api.arohaa.net/v1/web-push/subscriptions
WEB_PUSH_EVENTS_URL=https://api.arohaa.net/v1/web-push/events

# Shown once in Notification Center — server only, never NEXT_PUBLIC_*
WEB_PUSH_WEBHOOK_SECRET=

# B = Arohaa campaigns (default when subscribe URL points at arohaa.net)
# A = allow local POST /api/push/send for debugging
WEB_PUSH_MODEL=B

# --- Model A / local debug only (not used for Arohaa campaigns) ---
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@yourdomain.com
# WEB_PUSH_SEND_SECRET=

# Absolute base URL for assets if needed by the LP itself
NEXT_PUBLIC_SITE_URL=http://localhost:3016
